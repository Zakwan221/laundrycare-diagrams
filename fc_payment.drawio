<mxfile host="app.diagrams.net"><diagram id="fc_payment" name="Flowchart – Payment Processing"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="780" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Start" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="325" y="10" width="130" height="40" as="geometry"/></mxCell><mxCell id="in" value="Retrieve order no.&lt;br&gt;&amp;amp; amount due" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.12;fixedSize=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="275" y="75" width="230" height="46" as="geometry"/></mxCell><mxCell id="d0" value="Payment&lt;br&gt;channel?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="305" y="150" width="170" height="74" as="geometry"/></mxCell><mxCell id="d1" value="Cash or&lt;br&gt;card?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="75" y="250" width="150" height="74" as="geometry"/></mxCell><mxCell id="cash" value="Receive cash,&lt;br&gt;calculate change" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="5" y="360" width="140" height="50" as="geometry"/></mxCell><mxCell id="card" value="Charge card on&lt;br&gt;terminal" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="360" width="140" height="50" as="geometry"/></mxCell><mxCell id="bill" value="Create bill at payment&lt;br&gt;gateway (amount, ref)" style="round