<mxfile host="app.diagrams.net"><diagram id="fc_register" name="Flowchart – Customer Registration with OTP"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="760" pageHeight="1010" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Start" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="235" y="10" width="130" height="40" as="geometry"/></mxCell><mxCell id="in" value="Enter name, e-mail,&lt;br&gt;phone and password" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.12;fixedSize=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="75" width="240" height="50" as="geometry"/></mxCell><mxCell id="d1" value="All fields&lt;br&gt;valid?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="215" y="150" width="170" height="74" as="geometry"/></mxCell><mxCell id="err" value="Show field errors" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.12;fixedSize=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="161" width="170" height="50" as="geometry"/></mxCell><mxCell id="d2" value="E-mail / phone&lt;br&gt;already used?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="215" y="255" width="170" height="74" as="geometry"/></mxCell><mxCell id="ex" value="Show &amp;quot;account&lt;br&gt;exists – log in&amp;quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.12;fixedSize=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeom