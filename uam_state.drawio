<mxfile host="app.diagrams.net"><diagram id="uam_state" name="UAM – State Machine: User Account"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="380" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="12" y="85" width="20" height="20" as="geometry"/></mxCell><mxCell id="s2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="5" width="20" height="20" as="geometry"/></mxCell><mxCell id="pe" value="PENDING_&lt;br&gt;VERIFICATION" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="72" width="150" height="46" as="geometry"/></mxCell><mxCell id="ac" value="ACTIVE" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="72" width="160" height="46" as="geometry"/></mxCell><mxCell id="lo" value="LOCKED" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="680" y="72" width="160" height="46" as="geometry"/></mxCell><mxCell id="in" value="INACTIVE" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="160" height="46" as="geometry"/></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="122" y="290" width="26" height="26" as="geometry"/></mxCell><mxCell id="n11" value="Login is allowed only in ACTIVE.&lt;br&gt;LOCKED and INACTIVE return 401/403.&lt;br&gt;Every transition writes login_audit&lt;br&gt;(who, when, IP)." style="shape=note;size=12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;fillColor=#ffffff;strokeColor=#000000;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="270" height="100" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=none;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="s1" target="pe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="staff created&lt;br&gt;by manager" style="html=1;rounded=0;edgeStyle=none;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="s2" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="OTP verified" style="html=1;rounded=0;edgeStyle=none;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1" source="pe" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="5 failed logins" style="html=1;rounded=0;edgeStyle=none;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;endArrow=block;endFill=1;startArrow=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ac" target="lo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="15 min passed /&lt;br&gt;manager unlocks" style="html=1;rounded=0;edgeStyle=none;fontFamily=Arial;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#000000;endArrow=block;endFill=1;startArrow=none;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="lo" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="m